# =============================================================================
# Object build statements for EXECUTABLE target blend_benchmark


#############################################
# Order-only phony target for blend_benchmark

build cmake_object_order_depends_target_blend_benchmark: phony || cmake_object_order_depends_target_renderer_core

build benchmarks/CMakeFiles/blend_benchmark.dir/benchmark_blend.cpp.o: CXX_COMPILER__blend_benchmark_unscanned_Debug /Users/gopalkamineni/Downloads/mini-renderer/benchmarks/benchmark_blend.cpp || cmake_object_order_depends_target_blend_benchmark
  CONFIG = Debug
  DEFINES = -DRENDERER_HAS_NEON=1
  DEP_FILE = benchmarks/CMakeFiles/blend_benchmark.dir/benchmark_blend.cpp.o.d
  FLAGS = -g -std=gnu++20 -arch arm64 -Wall -Wextra -fsanitize=address,undefined -fno-omit-frame-pointer
  INCLUDES = -I/Users/gopalkamineni/Downloads/mini-renderer/include -isystem /Users/gopalkamineni/Downloads/mini-renderer/external/stb
  OBJECT_DIR = benchmarks/CMakeFiles/blend_benchmark.dir
  OBJECT_FILE_DIR = benchmarks/CMakeFiles/blend_benchmark.dir
  TARGET_COMPILE_PDB = benchmarks/CMakeFiles/blend_benchmark.dir/
  TARGET_PDB = benchmarks/blend_benchmark.pdb
  TARGET_SUPPORT_DIR = benchmarks/CMakeFiles/blend_benchmark.dir


# =============================================================================
# Link build statements for EXECUTABLE target blend_benchmark


#############################################
# Link the executable benchmarks/blend_benchmark

build benchmarks/blend_benchmark: CXX_EXECUTABLE_LINKER__blend_benchmark_Debug benchmarks/CMakeFiles/blend_benchmark.dir/benchmark_blend.cpp.o | librenderer_core.a || librenderer_core.a
  CONFIG = Debug
  FLAGS = -g -arch arm64
  LINK_FLAGS = -Wl,-search_paths_first -Wl,-headerpad_max_install_names -fsanitize=address,undefined
  LINK_LIBRARIES = librenderer_core.a
  OBJECT_DIR = benchmarks/CMakeFiles/blend_benchmark.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = benchmarks/CMakeFiles/blend_benchmark.dir/
  TARGET_FILE = benchmarks/blend_benchmark
  TARGET_PDB = benchmarks/blend_benchmark.pdb
  TARGET_SUPPORT_DIR = benchmarks/CMakeFiles/blend_benchmark.dir


